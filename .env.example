NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://maengelfix:change-me@db:5432/maengelfix
SESSION_COOKIE_NAME=maengelfix_session
APP_ORIGIN=https://maengelfix.kamilunavo.com
UPLOAD_DIR=/data/uploads

# E-Mail / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MängelFix <noreply@kamilunavo.com>

# Stripe – echte Werte erst im Deployment hinterlegen
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRIVATE_PRO_MONTHLY=
STRIPE_PRICE_PRIVATE_PRO_YEARLY=
STRIPE_PRICE_MANAGEMENT_STARTER_MONTHLY=
STRIPE_PRICE_MANAGEMENT_STARTER_YEARLY=
STRIPE_PRICE_MANAGEMENT_PRO_MONTHLY=
STRIPE_PRICE_MANAGEMENT_PRO_YEARLY=
STRIPE_PRICE_MANAGEMENT_BUSINESS_MONTHLY=
STRIPE_PRICE_MANAGEMENT_BUSINESS_YEARLY=

# Apple In-App Purchase / App Store Server API
APPLE_APP_BUNDLE_ID=com.kamilunavo.maengelfix
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Private-Key-Inhalt der heruntergeladenen .p8-Datei als eine Zeile mit \n zwischen den Zeilen
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_B64=

# Google Play Billing / Android Publisher API
GOOGLE_PLAY_PACKAGE_NAME=com.kamilunavo.maengelfix
# Vollständige Service-Account-JSON-Datei base64-kodiert; niemals ins Repository eintragen.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_B64=

# Google Play Real-time Developer Notifications (Pub/Sub authenticated push)
# Audience muss exakt der beim Pub/Sub Push konfigurierte OIDC-Audience-Wert sein.
GOOGLE_PLAY_RTDN_AUDIENCE=https://maengelfix.kamilunavo.com/api/billing/google-play/rtdn
# Exakt das Servicekonto, das Pub/Sub für den authentifizierten Push verwendet.
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# Kommagetrennte E-Mail-Adressen mit Kamilunavo-Adminzugriff
ADMIN_EMAILS=

# Datenbankcontainer
POSTGRES_PASSWORD=change-me

# SMTP powers invitations, verification, password reset, case notifications,
# task/calendar reminders and deadline escalations.
# Stripe variables activate checkout, subscription webhooks and billing portal.
# Apple variables activate StoreKit transaction verification and App Store Server Notifications.
# Google Play variables activate server-side subscriptionsv2 purchase verification.
# RTDN variables authenticate Google-signed Pub/Sub lifecycle notifications.
# Never commit real secrets to this file.
